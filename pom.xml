<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- parley-fsh-studio (Fsh Studio): edit, run and debug shell scripts, using fsh as the interpreter -->
	<groupId>us.bringardner</groupId>
	<artifactId>parley-fsh-studio</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<name>Fsh Studio - editor and debugger for shell scripts</name>
	<description>Edits, runs and debugs bash/POSIX-style scripts, using fsh (the FileSource Shell)
		as the interpreter. Formerly us.bringardner:bjl_shell_ide (BjlShellIde).</description>
	<url>https://github.com/parley-project/parley-fsh-studio</url>
	<inceptionYear>2004</inceptionYear>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>tony-bringardner</id>
			<name>Tony Bringardner</name>
			<url>https://github.com/tony-bringardner</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/parley-project/parley-fsh-studio.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/parley-project/parley-fsh-studio.git</developerConnection>
		<url>https://github.com/parley-project/parley-fsh-studio/tree/master</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>11</maven.compiler.release>
		<fsh.version>2.0.0-SNAPSHOT</fsh.version>
		<parley.version>2.0.0-SNAPSHOT</parley.version>
	</properties>

	<profiles>
		<!-- Native binary named fshstudio: mvn -Pnative package -->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>fshstudio</imageName>
							<mainClass>us.bringardner.fsh.ide.FshIDE</mainClass>
							<buildArgs>
								<!-- fsh (a dependency) ships native-image.properties with -Djava.awt.headless=true; this is a window app -->
								<buildArg>-Djava.awt.headless=false</buildArg>
								<!-- JNA and others look the platform charset (Cp1252) up by name -->
								<buildArg>-H:+AddAllCharsets</buildArg>
								<!-- Fsh Studio's and Parley's own classes and files, listed below as the image is built -->
								<buildArg>-H:ConfigurationFileDirectories=${project.build.directory}/native-config</buildArg>
							</buildArgs>
						</configuration>
					</plugin>
					<!-- target/native-config/reachability-metadata.json: every us.bringardner class on the class
					     path, with its members, and the other files of their jars (tools/NativeMetadata.java), so
					     the recorded resources/META-INF/native-image/.../reachability-metadata.json names only
					     what the JDK and the other libraries need (tools/record-native-config.sh) -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<version>3.8.1</version>
						<executions>
							<execution>
								<id>native-classpath</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>build-classpath</goal>
								</goals>
								<configuration>
									<includeScope>runtime</includeScope>
									<outputProperty>native.classpath</outputProperty>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.codehaus.mojo</groupId>
						<artifactId>exec-maven-plugin</artifactId>
						<version>3.5.0</version>
						<executions>
							<execution>
								<id>native-metadata</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>exec</goal>
								</goals>
								<configuration>
									<executable>${java.home}/bin/java</executable>
									<arguments>
										<argument>${project.basedir}/tools/NativeMetadata.java</argument>
										<argument>generate</argument>
										<argument>${project.build.directory}/native-config</argument>
										<argument>${project.build.outputDirectory}${path.separator}${native.classpath}</argument>
									</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<!-- AWT reads its font configuration from java.home/lib, and the image's java.home is
					     its own folder (see FshIDE.main): ship the JDK's file beside the exe -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>native-fontconfig</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/lib</outputDirectory>
									<resources>
										<resource>
											<directory>${java.home}/lib</directory>
											<includes>
												<include>fontconfig.bfc</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Bundles the JDBC file system too: mvn -Pjdbc ... -->
		<profile>
			<id>jdbc</id>
			<dependencies>
				<dependency>
					<groupId>us.bringardner.parley</groupId>
					<artifactId>parley-files-jdbc</artifactId>
					<version>${parley.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<!--
		  Release profile: everything Maven Central needs.
		    mvn -Prelease clean deploy
		  Kept out of normal builds so day-to-day work needs no GPG key or Central token.
		-->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.11.2</version>
						<configuration>
							<!-- Lenient so existing code releases cleanly; tighten to all,-missing later -->
							<doclint>none</doclint>
							<release>${maven.compiler.release}</release>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.7</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<!-- Passphrase comes from the MAVEN_GPG_PASSPHRASE environment variable -->
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<configuration>
							<!-- Matches the <server><id> in ~/.m2/settings.xml -->
							<publishingServerId>central</publishingServerId>
							<!-- false: you review and click Publish on central.sonatype.com -->
							<autoPublish>false</autoPublish>
							<deploymentName>${project.artifactId} ${project.version}</deploymentName>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<!-- Images and the spell-check dictionary; Eclipse has resources/ as a source folder -->
		<resources>
			<resource>
				<directory>resources</directory>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>us.bringardner.fsh.ide</Automatic-Module-Name>
						</manifestEntries>
						<manifest>
							<mainClass>us.bringardner.fsh.ide.FshIDE</mainClass>
							<addClasspath>true</addClasspath>
						</manifest>
					</archive>
				</configuration>
			</plugin>
			<!-- META-INF/parley/launcher.list in the jar: how parley-launcher runs it, and every jar it
			     needs with its SHA-256 (parley-launcher add NAME COORDINATES [MAIN]) -->
			<plugin>
				<groupId>us.bringardner.parley</groupId>
				<artifactId>parley-launcher-maven-plugin</artifactId>
				<version>${parley.version}</version>
				<executions>
					<execution>
						<goals>
							<goal>list</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<mainClass>us.bringardner.fsh.ide.FshIDE</mainClass>
					<options>
						<!-- (fsh's options, as fsh's installers give it: it runs fsh scripts) -->
						<option>-Xss16m</option>
						<option>-XX:+UseSerialGC</option>
						<option>-Xmn16m</option>
						<option>-XX:MinHeapFreeRatio=10</option>
						<option>-XX:MaxHeapFreeRatio=20</option>
						<option>-XX:-MaxFDLimit</option>
						<option>-Djava.library.path={native}</option>
						<option>17+:--enable-native-access=ALL-UNNAMED</option>
						<option>macos:-Xdock:name={app}</option>
					</options>
					<!-- (fsh's keyboard library and fshexec, from fsh's native jar) -->
					<nativeFrom>us.bringardner:fsh</nativeFrom>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
					<configuration>
						<!-- A JVM per test class (first needed by the JavaFX IDE's tests; kept, so the
						     Swing tests go on running apart from each other) -->
						<reuseForks>false</reuseForks>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- GitHub Packages -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-fsh-studio</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- The interpreter. Brings parley-files-ftp/-sftp at run time. -->
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>fsh</artifactId>
			<version>${fsh.version}</version>
		</dependency>
		<!-- The Loupe debugging protocol, and fsh's adapter for it (LoupeSession). -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-loupe</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>fsh-loupe</artifactId>
			<version>${fsh.version}</version>
		</dependency>
		<!-- Used directly: FileSource -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- The Parley app icon (with the terminal badge) for the windows and the Dock -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-brand</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- The Swing IDE's file chooser -->
		<!-- The gradient look shared with parley-files-viewer -->
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>bringardner-swing-widgets</artifactId>
			<version>1.1.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-swing</artifactId>
			<!-- 1.1.0: its dialogs follow the gradient look -->
			<version>2.0.0-SNAPSHOT</version>
		</dependency>

		<!-- The editor -->
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>autocomplete</artifactId>
			<version>3.3.2</version>
		</dependency>
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>spellchecker</artifactId>
			<version>3.0.0</version>
		</dependency>
		<!-- Templates are saved as XML -->
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>4.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.sun.xml.bind</groupId>
			<artifactId>jaxb-impl</artifactId>
			<version>4.0.3</version>
			<scope>runtime</scope>
		</dependency>
		<!-- The syntax-tree view lays out its tree with org.abego.treelayout -->
		<dependency>
			<groupId>org.abego.treelayout</groupId>
			<artifactId>org.abego.treelayout.core</artifactId>
			<version>1.0.3</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>

<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- fsh-ide: edit, run and debug shell scripts, using fsh as the interpreter -->
	<groupId>us.bringardner</groupId>
	<artifactId>fsh-ide</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>fsh-ide - editor and debugger for shell scripts</name>
	<description>Edits, runs and debugs bash/POSIX-style scripts, using fsh (the FileSource Shell)
		as the interpreter. Formerly us.bringardner:bjl_shell_ide (BjlShellIde).</description>
	<url>https://github.com/tony-bringardner/fsh-ide</url>
	<inceptionYear>2004</inceptionYear>

	<licenses>
		<license>
			<name>The Apache License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>tony-bringardner</id>
			<name>Tony Bringardner</name>
			<url>https://github.com/tony-bringardner</url>
		</developer>
	</developers>
	<scm>
		<connection>scm:git:https://github.com/tony-bringardner/fsh-ide.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/tony-bringardner/fsh-ide.git</developerConnection>
		<url>https://github.com/tony-bringardner/fsh-ide/tree/master</url>
	</scm>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>11</maven.compiler.release>
		<fsh.version>1.0.0-SNAPSHOT</fsh.version>
		<parley.version>1.0.0-SNAPSHOT</parley.version>
	</properties>

	<profiles>
		<!-- Native binary named fsh-ide: mvn -Pnative package -->
		<profile>
			<id>native</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.graalvm.buildtools</groupId>
						<artifactId>native-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<executions>
							<execution>
								<id>build-native</id>
								<goals>
									<goal>compile-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
						<configuration>
							<imageName>fsh-ide</imageName>
							<mainClass>us.bringardner.fsh.ide.FshIDE</mainClass>
							<buildArgs>
								<!-- fsh (a dependency) ships native-image.properties with -Djava.awt.headless=true; this is a window app -->
								<buildArg>-Djava.awt.headless=false</buildArg>
								<!-- JNA and others look the platform charset (Cp1252) up by name -->
								<buildArg>-H:+AddAllCharsets</buildArg>
							</buildArgs>
						</configuration>
					</plugin>
					<!-- AWT reads its font configuration from java.home/lib, and the image's java.home is
					     its own folder (see FshIDE.main): ship the JDK's file beside the exe -->
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>native-fontconfig</id>
								<phase>package</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/lib</outputDirectory>
									<resources>
										<resource>
											<directory>${java.home}/lib</directory>
											<includes>
												<include>fontconfig.bfc</include>
											</includes>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<!-- Bundles the JDBC file system too: mvn -Pjdbc ... -->
		<profile>
			<id>jdbc</id>
			<dependencies>
				<dependency>
					<groupId>us.bringardner.parley</groupId>
					<artifactId>parley-files-jdbc</artifactId>
					<version>${parley.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
		<!--
		  Release profile: everything Maven Central needs.
		    mvn -Prelease clean deploy
		  Kept out of normal builds so day-to-day work needs no GPG key or Central token.
		-->
		<profile>
			<id>release</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<version>3.3.1</version>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<version>3.11.2</version>
						<configuration>
							<!-- Lenient so existing code releases cleanly; tighten to all,-missing later -->
							<doclint>none</doclint>
							<release>${maven.compiler.release}</release>
						</configuration>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-gpg-plugin</artifactId>
						<version>3.2.7</version>
						<executions>
							<execution>
								<id>sign-artifacts</id>
								<phase>verify</phase>
								<goals>
									<goal>sign</goal>
								</goals>
								<!-- Passphrase comes from the MAVEN_GPG_PASSPHRASE environment variable -->
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.sonatype.central</groupId>
						<artifactId>central-publishing-maven-plugin</artifactId>
						<version>0.11.0</version>
						<extensions>true</extensions>
						<configuration>
							<!-- Matches the <server><id> in ~/.m2/settings.xml -->
							<publishingServerId>central</publishingServerId>
							<!-- false: you review and click Publish on central.sonatype.com -->
							<autoPublish>false</autoPublish>
							<deploymentName>${project.artifactId} ${project.version}</deploymentName>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

	<build>
		<!-- Images and the spell-check dictionary; Eclipse has resources/ as a source folder -->
		<resources>
			<resource>
				<directory>resources</directory>
			</resource>
		</resources>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.2</version>
				<configuration>
					<archive>
						<manifestEntries>
							<Automatic-Module-Name>us.bringardner.fsh.ide</Automatic-Module-Name>
						</manifestEntries>
						<manifest>
							<mainClass>us.bringardner.fsh.ide.FshIDE</mainClass>
							<addClasspath>true</addClasspath>
						</manifest>
					</archive>
				</configuration>
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
					<configuration>
						<!-- A JVM per test class: on macOS, JavaFX can't start in a JVM where
						     Swing (AWT) is already running, so the JavaFX IDE's tests can't
						     share one with the Swing IDE's -->
						<reuseForks>false</reuseForks>
							<!-- JavaFX unpacks its native libraries under user.home, and the tests point
							     that at a temporary folder. On Windows a loaded DLL can't be deleted, so
							     the folder couldn't be cleaned up (and the class errored): the cache
							     is kept in target instead -->
							<systemPropertyVariables>
								<javafx.cachedir>${project.build.directory}/javafx-cache</javafx.cachedir>
							</systemPropertyVariables>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- GitHub Packages -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/fsh-ide</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- The interpreter. Brings parley-files-ftp/-sftp at run time. -->
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>fsh</artifactId>
			<version>${fsh.version}</version>
		</dependency>
		<!-- The Loupe debugging protocol, and fsh's adapter for it (LoupeSession). -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-loupe</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>fsh-loupe</artifactId>
			<version>${fsh.version}</version>
		</dependency>
		<!-- Used directly: FileSource -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- The Parley app icon (with the terminal badge) for the windows and the Dock -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-brand</artifactId>
			<version>${parley.version}</version>
		</dependency>
		<!-- The Swing IDE's file chooser -->
		<!-- The gradient look shared with parley-files-viewer (Swing and JavaFX) -->
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>bringardner-swing-widgets</artifactId>
			<version>1.1.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner</groupId>
			<artifactId>bringardner-fx-widgets</artifactId>
			<version>1.1.0-SNAPSHOT</version>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-swing</artifactId>
			<!-- 1.1.0: its dialogs follow the gradient look -->
			<version>1.1.0-SNAPSHOT</version>
		</dependency>

		<!-- The editor -->
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>autocomplete</artifactId>
			<version>3.3.2</version>
		</dependency>
		<dependency>
			<groupId>com.fifesoft</groupId>
			<artifactId>spellchecker</artifactId>
			<version>3.0.0</version>
		</dependency>
		<!-- Templates are saved as XML -->
		<dependency>
			<groupId>jakarta.xml.bind</groupId>
			<artifactId>jakarta.xml.bind-api</artifactId>
			<version>4.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.sun.xml.bind</groupId>
			<artifactId>jaxb-impl</artifactId>
			<version>4.0.3</version>
			<scope>runtime</scope>
		</dependency>
		<!-- The JavaFX IDE (us.bringardner.fsh.ide.fx, started by FshIdeFx): JavaFX, the
		     RichTextFX code editor, and parley-files-fx's file chooser (any file system) -->
		<dependency>
			<groupId>org.openjfx</groupId>
			<artifactId>javafx-controls</artifactId>
			<!-- 17 LTS: it runs on Java 11, like the library's other components -->
			<version>17.0.20</version>
		</dependency>
		<dependency>
			<groupId>org.fxmisc.richtext</groupId>
			<artifactId>richtextfx</artifactId>
			<version>0.11.0</version>
				<!-- It declares JavaFX 11 for this platform. The unclassified JavaFX jars are empty:
				     the classes are in the platform jars, so those 11 jars took the graphics and base
				     classes from under the 17 controls (NoSuchFieldError AccessibleRole.DIALOG).
				     JavaFX comes from javafx-controls above, all one version. -->
				<exclusions>
					<exclusion>
						<groupId>org.openjfx</groupId>
						<artifactId>*</artifactId>
					</exclusion>
				</exclusions>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files-fx</artifactId>
			<!-- 1.1.0: its dialogs follow the gradient look -->
			<version>1.1.0-SNAPSHOT</version>
		</dependency>
		<!-- The syntax-tree view lays out its tree with org.abego.treelayout -->
		<dependency>
			<groupId>org.abego.treelayout</groupId>
			<artifactId>org.abego.treelayout.core</artifactId>
			<version>1.0.3</version>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>5.11.4</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
